# Copy this file to .env and set the values. .env is ignored by git.
# docker compose reads .env automatically.

# --- secrets (never commit real values)
# Token that billing sends to the payment service (Authorization: Bearer ...).
PAYMENT_API_TOKEN=change-me

# --- logging
# text (key=value) or json
LOG_FORMAT=text

# --- broker
BROKER_MAX_ATTEMPTS=5
BROKER_ACK_TIMEOUT=30s
BROKER_RETRY_BASE=1s
BROKER_DEDUP_RETENTION=24h
# demo only: lose the answer of the next N publishes after the commit
BROKER_LOSE_PUBLISH_RESPONSES=0

# --- order service (producer)
PUBLISH_TIMEOUT=1s
PUBLISH_MAX_ATTEMPTS=4
OUTBOX_INTERVAL=2s

# --- billing -> payment calls
PAYMENT_TIMEOUT=800ms
PAYMENT_MAX_ATTEMPTS=3
PAYMENT_LOOKUP_TIMEOUT=800ms

# --- payment service
PAYMENT_LIMIT_CENTS=1000000
# demo only: simulated latency, and the answer of the next N charges is lost after the commit
PAYMENT_LATENCY=0s
PAYMENT_LOSE_RESPONSES=0

# --- consumers
INVENTORY_WORKERS=2
BILLING_WORKERS=1
BILLING_REPLICAS=2
# demo only: crash inventory once after its local effect, before ACK (after_effect | before_effect)
CRASH_ONCE=
