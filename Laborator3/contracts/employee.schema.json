{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pad-lab3/contracts/employee.schema.json",
  "title": "Employee",
  "description": "Angajatul păstrat de data warehouse. version, updated_at și updated_by sunt scrise de DW și ignorate la PUT.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name"],
  "properties": {
    "id":         { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "name":       { "type": "string", "minLength": 1, "maxLength": 200 },
    "department": { "type": "string", "maxLength": 200 },
    "position":   { "type": "string", "maxLength": 200 },
    "email":      { "type": "string", "maxLength": 200, "pattern": "^$|@" },
    "salary":     { "type": "integer", "minimum": 0 },
    "version":    { "type": "integer", "minimum": 0, "readOnly": true },
    "updated_at": { "type": "string", "format": "date-time", "readOnly": true },
    "updated_by": { "type": "string", "readOnly": true }
  },
  "$defs": {
    "patch": {
      "description": "Corpul POST /employees/{id}: doar câmpurile modificate, valori absolute.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "name":       { "type": "string", "minLength": 1, "maxLength": 200 },
        "department": { "type": "string", "maxLength": 200 },
        "position":   { "type": "string", "maxLength": 200 },
        "email":      { "type": "string", "maxLength": 200 },
        "salary":     { "type": "integer", "minimum": 0 }
      }
    }
  }
}
