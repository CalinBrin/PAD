# Copy to .env to change the defaults (docker compose reads .env automatically).

# --- logging: text (key=value) or json
LOG_FORMAT=text

# --- proxy
PROXY_ALGORITHM=round_robin    # round_robin | least_conn (also at run time: POST :8081/proxy/balancer?algorithm=)
CACHE_ENABLED=true             # also at run time: POST :8081/proxy/cache?enabled=false
CACHE_TTL=30s                  # upper bound; the warehouse max-age may shorten it
WRITE_GRACE=3s                 # extra invalidation after a write whose outcome is unknown (> DW_STORE_TIMEOUT)
UPSTREAM_TIMEOUT=2s            # deadline of one attempt towards a replica
REQUEST_TIMEOUT=6s             # deadline of the whole request, retries included
MAX_ATTEMPTS=3                 # GET/PUT/DELETE, POST only with Idempotency-Key
HEALTH_INTERVAL=2s             # active health check (GET /readyz of each replica)
HEALTH_TIMEOUT=1s
BREAKER_THRESHOLD=3            # consecutive failures that open the breaker of a replica
BREAKER_COOLDOWN=5s
CLIENT_IDLE_TIMEOUT=120s       # keep-alive of the client connections
MAX_CONNS_PER_CLIENT=100

# --- warehouse replicas
DW_STORE_TIMEOUT=2s
DW_CACHE_MAX_AGE=30
DW_FEED_OVERLAP=5s
DW_MAX_INFLIGHT=256
CASSANDRA_CONSISTENCY=QUORUM
CASSANDRA_HEAP=768M

# --- source nodes
SOURCE_SEED_COUNT=20
SOURCE_POLL_INTERVAL=2s
SOURCE_MUTATE_INTERVAL=0       # e.g. 10s: the source changes one of its employees periodically
